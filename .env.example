# Новый тестовый токен Telegram-бота. Не коммитить реальный .env.
BOT_TOKEN=replace_me

# Ровно два числовых Telegram user ID через запятую, без @username.
ALLOWED_USER_IDS=111111111,222222222

# 1 = бот отвечает и ставит тестовый таймер без сна/выключения. 0 = разрешить реальные действия.
DRY_RUN=1

# Долгое получение обновлений Telegram, секунд. Допустимо 1-50.
POLL_TIMEOUT=25

# Относительный путь хранится рядом с этим файлом.
STATE_PATH=state.json
